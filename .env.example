# =============================================================================
# SOUNDLOG - VARIÁVEIS DE AMBIENTE (MODELO SEGURO)
# =============================================================================
# NUNCA comite o arquivo .env real no Git!
# Copie este arquivo para .env e preencha com suas credenciais reais.

# --- SUPABASE (Obrigatório para autenticação, banco e perfis reais) ---
# O Anon Key é público e protegido pelo Row Level Security (RLS) do Supabase.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ATENÇÃO: NUNCA coloque chaves com permissão de administrador (Service Role Key)
# no frontend (arquivos com prefixo VITE_). Chaves de serviço só devem ser usadas no backend.
# SUPABASE_SERVICE_ROLE_KEY=nunca-coloque-aqui

# --- SPOTIFY API (Opcional - caso não fornecido, o app usa o iTunes como fallback) ---
VITE_SPOTIFY_CLIENT_ID=seu-client-id-spotify
VITE_SPOTIFY_CLIENT_SECRET=seu-client-secret-spotify
